# Parametry aplikacji LPN sterowane flaga builda (-DCONFIG_...=...).
# Kolejne symbole dokladaj tutaj; domyslne wartosci maja nic nie zmieniac.

config LPN_SENSOR_INTERVAL_S
	int "Interwal odczytu i publikacji temperatury do Frienda [s]"
	default 10
	range 1 86400
	help
	  Odstep miedzy kolejnymi publikacjami Sensor Server -> Friend.
	  Sterowane build-time: -DCONFIG_LPN_SENSOR_INTERVAL_S=<sekundy>.

	  Uwaga: niezaleznie od tego LPN polluje Frienda co
	  CONFIG_BT_MESH_LPN_POLL_TIMEOUT (x100 ms).

source "Kconfig.zephyr"
