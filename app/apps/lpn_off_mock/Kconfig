# Parametry aplikacji LPN OFF MOCK sterowane flaga builda (-DCONFIG_...=...).
# Te same symbole co w apps/lpn_off, apps/lpn i apps/lpn_mock - dla spojnosci pomiarow.

config LPN_SENSOR_INTERVAL_S
	int "Interwal odczytu i publikacji temperatury do Frienda [s]"
	default 10
	range 1 86400
	help
	  Odstep miedzy kolejnymi publikacjami Sensor Server -> Friend.
	  Sterowane build-time: -DCONFIG_LPN_SENSOR_INTERVAL_S=<sekundy>.

	  Tu jest to jednoczesnie czas spedzony w System OFF: wezel budzi sie,
	  publikuje i znowu odcina zasilanie. Pobudke daje GRTC taktowany z LFXO.

config LPN_PROV_TIMEOUT_S
	int "Limit czasu na provisioning i konfiguracje od Frienda [s]"
	default 60
	range 5 600
	help
	  Dotyczy tylko zimnego startu. Po przekroczeniu wezel i tak idzie w
	  System OFF, zeby pomiar nie zawisl.

config LPN_CFG_SETTLE_MS
	int "Zapas po wykryciu konca konfiguracji, przed wejsciem w tryb LPN [ms]"
	default 8000
	range 0 30000
	help
	  Dotyczy tylko zimnego startu. Znacznikiem konca konfiguracji jest
	  ustawiony adres publikacji, czyli ostatni krok Frienda (mod_pub_set) -
	  ten zapas pokrywa tylko retransmisje Frienda po zgubionym Status.

	  Caly ten czas LPN jest zwyklym wezlem mesh, wiec skanuje bez przerwy
	  (~4-5 mA). Do pomiarow energii warto zejsc do 500-1000 ms:
	  -DCONFIG_LPN_CFG_SETTLE_MS=1000.

config LPN_FRIENDSHIP
	bool "Nawiazuj friendship przed publikacja"
	default y
	help
	  Wylacz, zeby zmierzyc cykl bez kosztu Friend Request (okno na oferty
	  to ~1,1 s ciaglego RX). Publikacja dziala bez friendship - to tylko TX.

config LPN_FRIENDSHIP_TIMEOUT_S
	int "Limit czasu na nawiazanie friendship [s]"
	default 20
	range 1 120
	help
	  Bez "depends on LPN_FRIENDSHIP" swiadomie: main.c bramkuje uzycie
	  zwyklym if-em na IS_ENABLED(), a nie #if, wiec ten symbol musi istniec
	  takze przy LPN_FRIENDSHIP=n - inaczej build nie linkuje sie na
	  niezdefiniowanym CONFIG_LPN_FRIENDSHIP_TIMEOUT_S.

config LPN_DRAIN_MS
	int "Zwloka po publikacji, zeby reklama wyszla w eter [ms]"
	default 500
	range 0 5000
	help
	  System OFF ucina nadawanie w polowie, wiec trzeba dac adverowi czas.

config LPN_SEQ_MARGIN
	int "Zapas doliczany do odtworzonego licznika seq"
	default 32
	range 0 4096
	help
	  Pokrywa wiadomosci, ktore mogly wyjsc po zapisie bloku retencyjnego.
	  Bez zapasu Friend moglby odrzucic nas na replay protection.

source "Kconfig.zephyr"
