{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build: Friend",
            "type": "shell",
            "command": "west build -b nrf52840dongle/nrf52840 -p always -d build/friend app/apps/friend",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
