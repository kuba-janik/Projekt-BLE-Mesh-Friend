        {
            "label": "Build: Friend + LPN",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build: Node Friend (nRF52840 Dongle)",
                "Build: LPN (BTZ_EndDevice / nRF54L15)"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Dongle: logi (monitor)",
            "type": "shell",
            "command": "PORT=$(for p in /dev/ttyACM*; do n=$(basename $p); [ \"$(cat /sys/class/tty/$n/device/../product 2>/dev/null)\" = 'nRF52840 Dongle' ] && echo $p; done | sort | tail -1); if [ -z \"$PORT\" ]; then echo 'Brak portu dongla — wepnij go i upewnij sie, ze dziala aplikacja (nie tryb DFU).'; else echo \"Monitor: $PORT  (wyjscie: Ctrl+])\"; python3 -m serial.tools.miniterm --raw \"$PORT\" 115200; fi",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true,
                "clear": true,
                "showReuseMessage": false
            },
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "Flash: Friend",
            "type": "shell",
            "command": "NRFUTIL_HOME=/home/goodbyte/.nrfutil /home/goodbyte/.nrfutil/bin/nrfutil nrf5sdk-tools pkg generate --hw-version 52 --sd-req 0x00 --application build/friend/friend/zephyr/zephyr.hex --application-version 1 build/friend/friend_dfu.zip && NRFUTIL_HOME=/home/goodbyte/.nrfutil /home/goodbyte/.nrfutil/bin/nrfutil nrf5sdk-tools dfu usb-serial -pkg build/friend/friend_dfu.zip -p ${input:dfuPort}",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Build + Flash: Friend",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build: Friend",
                "Flash: Friend"
            ],
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "dfuPort",
            "type": "promptString",
            "description": "Port bootloadera dongla (po RESET; sprawdz: ls /dev/ttyACM*)",
            "default": "/dev/ttyACM0"
        }
    ]
